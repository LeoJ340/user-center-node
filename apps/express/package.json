{
  "name": "@user-center/express",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "clean": "rimraf dist",
    "build": "pnpm run clean && pnpm -w exec tsc -p apps/express/tsconfig.json && pnpm -w exec tsc-alias -p apps/express/tsconfig.json",
    "lint": "pnpm -w exec eslint \"apps/express/src/**/*.ts\" \"apps/express/tests/**/*.ts\"",
    "lint:fix": "pnpm -w exec eslint \"apps/express/src/**/*.ts\" \"apps/express/tests/**/*.ts\" --fix",
    "format": "pnpm -w exec prettier --write \"apps/express/src/**/*.ts\" \"apps/express/tests/**/*.ts\" \"apps/express/*.json\"",
    "format:check": "pnpm -w exec prettier --check \"apps/express/src/**/*.ts\" \"apps/express/tests/**/*.ts\" \"apps/express/*.json\"",
    "typecheck": "pnpm -w exec tsc -p apps/express/tsconfig.json --noEmit && pnpm -w exec tsc -p apps/express/tests/tsconfig.json --noEmit",
    "test": "cross-env TS_NODE_PROJECT=tests/tsconfig.json node --test -r ts-node/register -r tsconfig-paths/register \"tests/**/*.test.ts\"",
    "start": "cross-env NODE_ENV=development node dist/server.js",
    "start:test": "cross-env NODE_ENV=test node dist/server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.18.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^5.11.0",
    "sequelize": "6.37.8",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "ts-node-dev": "^2.0.0"
  }
}
