generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid()) @db.Char(36)
  nickname     String?   @db.VarChar(255)
  userAccount  String?   @map("user_account") @db.VarChar(255)
  avatar       String?   @db.VarChar(255)
  gender       Int?      @db.TinyInt
  userPassword String    @map("user_password") @db.VarChar(255)
  phone        String?   @db.VarChar(255)
  email        String?   @db.VarChar(255)
  userStatus   Int       @default(0) @map("user_status") @db.TinyInt
  deleted      Int       @default(0) @db.TinyInt
  createdAt    DateTime  @default(now()) @map("create_time")
  updatedAt    DateTime? @default(now()) @map("update_time")

  @@map("user")
}
